# ══════════════════════════════════════════════════════════════════════
#  Actuator AI — production environment template (Oracle Cloud / ARM64)
#
#      cp .env.production.example .env.production
#      chmod 600 .env.production
#
#  .env.production is gitignored — never commit real values.
#  docker-compose.yml injects this file into the caddy, app and postgres
#  containers, so plain `docker compose up -d` needs no extra flags.
# ══════════════════════════════════════════════════════════════════════

# ── Edge / reverse proxy (Caddy) ──────────────────────────────────────
# Public DNS name pointing at this VM's IP, e.g. support.example.com
# (a bare IP works too — see the "Option B" block in Caddyfile)
DOMAIN=support.example.com
# ACME / Let's Encrypt account email (expiry notices)
ACME_EMAIL=admin@example.com

# ── Docker build target ───────────────────────────────────────────────
# linux/arm64 = Oracle Cloud Ampere A1 (native). Set to linux/amd64 only
# when you deliberately build/run this stack on an x86 machine.
DOCKER_PLATFORM=linux/arm64

# ── Application runtime ───────────────────────────────────────────────
ENVIRONMENT=production
# Generate: openssl rand -hex 32   (the app refuses to boot in production
# with the default value, so this one is mandatory)
SECRET_KEY=CHANGE_ME-openssl-rand-hex-32
# Same-origin SPA + API; list your public origins explicitly for production
CORS_ORIGINS=https://support.example.com,https://www.support.example.com
PROJECT_NAME=Actuator AI
API_V1_STR=/api/v1
# uvicorn worker processes inside the app container (2–4 suits A1 4 OCPU)
WEB_CONCURRENCY=2
# Internal app port — keep 8000, Caddy proxies to app:8000
PORT=8000

# ── WebSocket (streaming chat) ────────────────────────────────────────
#     endpoint : wss://<DOMAIN>/api/v1/chat/ws
#     auth     : JWT passed as ?token=<JWT> in the WS query string
#     origin   : the browser derives the socket URL from
#                window.location.origin, so no WS-specific env key exists —
#                CORS_ORIGINS above is the only origin control, and it
#                applies to the WS handshake as well
#     proxying : the Caddyfile `@ws` handle block forwards the Upgrade and
#                Connection headers to app:8000 with flush_interval -1
#                (no response buffering, no idle-timeout mid-stream)
#     scheme   : Caddy 308-redirects http:// → https://, so browsers always
#                open the socket as wss:// on their own
#
# Tunables that DO affect the socket, set in docker-compose.yml / Caddyfile:
#   - Caddy: keepalive_timeout 60s (idle WS stays open for streaming)
#   - app  : WEB_CONCURRENCY above (each worker serves its own sockets)

# ── PostgreSQL (bundled `postgres` service) ───────────────────────────
# POSTGRES_SERVER is forced to `postgres` (docker DNS) by docker-compose.yml;
# the values below must match between app and db because both read this file.
POSTGRES_DB=actuator_ai
POSTGRES_USER=actuator
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME-openssl-rand-hex-24
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# Optional: external managed Postgres instead of the bundled container.
# When set, it takes precedence over POSTGRES_* everywhere (SQLAlchemy,
# db_tools and the MCP postgres server). Leave it commented out to use the
# bundled database.
# DATABASE_URL=postgresql://user:password@host:5432/actuator_ai?sslmode=require

# ── LLM inference provider (at least one required) ────────────────────
# Option A — Google AI Studio (Gemini, free tier)
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Option B — OpenAI-compatible gateway (OpenAI, OmniRouter, LiteLLM, ...)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OMNIROUTER_API_KEY=...
# OMNIROUTER_MODEL=auto
# OMNIROUTER_BASE_URL=http://omnirouter:20128/v1

# ── Optional integrations (safe to leave empty) ───────────────────────
TAVILY_API_KEY=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Actuator AI <noreply@example.com>
