# ── Environment ───────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production

# ── Security ─────────────────────────────────
SECRET_KEY=your-secret-key-here  # Generate with: openssl rand -hex 32

# ── CORS (comma-separated origins) ───────────
CORS_ORIGINS=*
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── OpenAI-compatible LLM provider ───────────
OPENAI_API_KEY=your_provider_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── PostgreSQL Database ───────────────────────
# Cloud PostgreSQL URL (Neon, Supabase, Render, Railway):
# DATABASE_URL=postgresql://user:password@ep-cool-host.neon.tech/neondb?sslmode=require

# Or Local PostgreSQL container credentials:
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=actuator_ai

# ── Application Settings ─────────────────────
PROJECT_NAME=Actuator AI
API_V1_STR=/api/v1

# ── Optional: container runtime (read by the Dockerfile CMD) ──
# PORT=8000              # uvicorn bind port inside the container
# WEB_CONCURRENCY=2      # uvicorn worker processes
