# ── Environment ───────────────────────────────
ENVIRONMENT=development
# ENVIRONMENT=production

# ── Security ─────────────────────────────────
SECRET_KEY=your-secret-key-here  # Generate with: openssl rand -hex 32

# ── CORS (comma-separated origins) ───────────
CORS_ORIGINS=*
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── LLM Provider (modelscope | groq | openrouter | openai | ollama) ─
LLM_PROVIDER=modelscope

# ── ModelScope / Qwen (Recommended — OpenAI-compatible Qwen API) ─
MODELSCOPE_TOKEN=your_modelscope_token_here
MODELSCOPE_MODEL=Qwen-Ambassador/Qwen3.7-Max

# ── Groq Cloud (Alternative FREE Tier - High speed & tool calling) ─
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenRouter (Alternative FREE Tier) ───────────
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Local Ollama (Only if running model locally) ─
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ── PostgreSQL Database ───────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=actuator_ai

# ── Application Settings ─────────────────────
PROJECT_NAME=Actuator AI
API_V1_STR=/api/v1

# ── Optional: Docker Compose Port ─────────────
# APP_PORT=8000

# ── Optional Services ────────────────────────
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# TAVILY_API_KEY=tvly-...
# SENDGRID_API_KEY=SG....
# SLACK_WEBHOOK_URL=https://hooks.slack.com/...
# REDIS_URL=redis://localhost:6379
